{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "maillotgallery/data/schema.json",
  "title": "MaillotGallery : collection de maillots",
  "description": "Schéma de validation de data.json et de data/data-avance.json. Un fichier valide est un tableau d'objets maillot.",
  "type": "array",
  "minItems": 1,
  "items": {
    "$ref": "#/definitions/maillot"
  },
  "definitions": {
    "maillot": {
      "type": "object",
      "description": "Une fiche de maillot. Toute clé non listée ici est refusée, ce qui attrape les fautes de frappe (prix au lieu de prixMoyen).",
      "required": [
        "id",
        "titre",
        "commune",
        "prixMoyen"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1,
          "description": "Identifiant numérique unique de la fiche."
        },
        "titre": {
          "type": "string",
          "minLength": 3,
          "maxLength": 80,
          "description": "Nom affiché de la fiche, par exemple « Real Madrid, domicile 2023/24 »."
        },
        "commune": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60,
          "description": "Ville du club (capitale pour une sélection nationale)."
        },
        "description": {
          "type": "string",
          "minLength": 10,
          "maxLength": 300,
          "description": "Anecdote ou histoire du maillot."
        },
        "prixMoyen": {
          "type": "number",
          "minimum": 0,
          "description": "Prix moyen indicatif d'un maillot réplique, en francs suisses (CHF). Jamais négatif."
        },
        "estOuvert": {
          "type": "boolean",
          "description": "true si la fiche est publiée dans la vitrine, false si elle est en préparation."
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 2
          },
          "minItems": 1,
          "uniqueItems": true,
          "description": "Mots-clés pour les filtres et la recherche, sans doublon."
        },
        "image": {
          "type": "string",
          "pattern": "^images/[a-z0-9-]+\\.(jpg|jpeg|png|webp)$",
          "description": "Chemin relatif de la photo, dans le dossier images/."
        },
        "club": {
          "type": "string",
          "minLength": 2,
          "description": "Nom du club ou de la sélection."
        },
        "saison": {
          "type": "string",
          "pattern": "^[0-9]{4}(/[0-9]{2})?$",
          "description": "Saison (2023/24) ou année (2022)."
        },
        "annee": {
          "type": "integer",
          "minimum": 1900,
          "maximum": 2100,
          "description": "Première année de la saison, pour les filtres du type « depuis 2010 »."
        },
        "type": {
          "type": "string",
          "enum": [
            "domicile",
            "exterieur"
          ],
          "description": "Maillot domicile ou extérieur."
        },
        "sponsor": {
          "type": "string",
          "minLength": 2,
          "description": "Sponsor principal, ou « Aucun »."
        },
        "equipementier": {
          "type": "string",
          "minLength": 2,
          "description": "Marque qui fabrique le maillot."
        },
        "lieu": {
          "type": "string",
          "minLength": 3,
          "description": "Lieu auquel se rapportent les coordonnées et les horaires (parcours avancé)."
        },
        "coordonnees": {
          "$ref": "#/definitions/coordonnees"
        },
        "horaires": {
          "$ref": "#/definitions/horaires"
        }
      }
    },
    "coordonnees": {
      "type": "object",
      "description": "Position GPS en degrés décimaux, dans une boîte englobante qui couvre la Suisse romande.",
      "required": [
        "lat",
        "lng"
      ],
      "additionalProperties": false,
      "properties": {
        "lat": {
          "type": "number",
          "minimum": 45.8,
          "maximum": 47.5,
          "description": "Latitude (nord)."
        },
        "lng": {
          "type": "number",
          "minimum": 5.9,
          "maximum": 8.5,
          "description": "Longitude (est)."
        }
      }
    },
    "plage": {
      "type": "object",
      "description": "Une plage d'ouverture, en heures 24 h au format HH:MM.",
      "required": [
        "ouverture",
        "fermeture"
      ],
      "additionalProperties": false,
      "properties": {
        "ouverture": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "fermeture": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
        }
      }
    },
    "horaires": {
      "type": "object",
      "description": "Horaires par jour. Chaque jour contient une liste de plages. Une liste vide veut dire fermé.",
      "required": [
        "lundi",
        "mardi",
        "mercredi",
        "jeudi",
        "vendredi",
        "samedi",
        "dimanche"
      ],
      "additionalProperties": false,
      "properties": {
        "lundi": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/plage"
          },
          "maxItems": 3
        },
        "mardi": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/plage"
          },
          "maxItems": 3
        },
        "mercredi": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/plage"
          },
          "maxItems": 3
        },
        "jeudi": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/plage"
          },
          "maxItems": 3
        },
        "vendredi": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/plage"
          },
          "maxItems": 3
        },
        "samedi": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/plage"
          },
          "maxItems": 3
        },
        "dimanche": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/plage"
          },
          "maxItems": 3
        }
      }
    }
  }
}
